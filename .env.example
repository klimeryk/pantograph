# Bot token from the Discord Developer Portal → your application → Bot → Reset Token
DISCORD_TOKEN=

# HTTP server for the web page and the event stream
PORT=3000
HOST=127.0.0.1

# Public origin of the web page; channel links are built from it.
# Defaults to http://localhost:5173 (Vite dev server) or http://localhost:$PORT in production.
PUBLIC_URL=

# Optional: where runtime state (mirrored channels, links, paused flags) is persisted
# STATE_FILE=backend/data/bot-state.json

# debug | info | warn | error
LOG_LEVEL=info
